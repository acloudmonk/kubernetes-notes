{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "credentials", "config", "api", "relay", "worker", "postgresql", "rabbitmq", "podDisruptionBudget", "autoscaling", "placement", "test"],
  "properties": {
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret"],
      "properties": {"existingSecret": {"type": "string", "minLength": 1}}
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["databaseName", "databaseUser", "amqpUser", "relayIntervalSeconds"],
      "properties": {
        "databaseName": {"type": "string", "minLength": 1},
        "databaseUser": {"type": "string", "minLength": 1},
        "amqpUser": {"type": "string", "minLength": 1},
        "relayIntervalSeconds": {"type": "string", "pattern": "^[1-9][0-9]*$"}
      }
    },
    "api": {"$ref": "#/$defs/scalableComponent"},
    "relay": {"$ref": "#/$defs/scalableComponent"},
    "worker": {"$ref": "#/$defs/scalableComponent"},
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "storage", "resources"],
      "properties": {
        "image": {"type": "string", "minLength": 1},
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "className", "size"],
          "properties": {
            "enabled": {"type": "boolean"},
            "className": {"type": "string"},
            "size": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"}
          }
        },
        "resources": {"$ref": "#/$defs/resources"}
      }
    },
    "rabbitmq": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "resources"],
      "properties": {
        "image": {"type": "string", "minLength": 1},
        "resources": {"$ref": "#/$defs/resources"}
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "apiMinAvailable"],
      "properties": {
        "enabled": {"type": "boolean"},
        "apiMinAvailable": {"type": "integer", "minimum": 0}
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "minReplicas", "maxReplicas", "targetCpuUtilizationPercentage"],
      "properties": {
        "enabled": {"type": "boolean"},
        "minReplicas": {"type": "integer", "minimum": 1},
        "maxReplicas": {"type": "integer", "minimum": 1},
        "targetCpuUtilizationPercentage": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeSelector", "tolerations", "affinity"],
      "properties": {
        "nodeSelector": {"type": "object"},
        "tolerations": {"type": "array"},
        "affinity": {"type": "object"}
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}}
    }
  },
  "$defs": {
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu", "memory"],
          "properties": {"cpu": {"type": "string"}, "memory": {"type": "string"}}
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu", "memory"],
          "properties": {"cpu": {"type": "string"}, "memory": {"type": "string"}}
        }
      }
    },
    "scalableComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicas", "resources"],
      "properties": {
        "replicas": {"type": "integer", "minimum": 1},
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port"],
          "properties": {"port": {"type": "integer", "minimum": 1, "maximum": 65535}}
        },
        "resources": {"$ref": "#/$defs/resources"}
      }
    }
  }
}
